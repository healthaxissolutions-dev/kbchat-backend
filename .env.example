# Server Configuration
PORT=4000
NODE_ENV=development
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Azure Entra ID (OAuth 2.0)
AZURE_AD_CLIENT_ID=<azure-app-registration-client-id>
AZURE_AD_CLIENT_SECRET=<azure-app-registration-client-secret>
AZURE_AD_TENANT_ID=<azure-tenant-id>
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# JWT Security — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<generate-a-64-byte-random-hex-string>
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Database (SQL Server)
DB_SERVER=<sql-server-hostname>
DB_NAME=<database-name>
DB_USER=<sql-username>
DB_PASSWORD=<sql-password>
DB_ENCRYPT=true
DB_AUTH=sql

# Azure Storage
AZURE_STORAGE_ACCOUNT=<storage-account-name>
AZURE_STORAGE_CONTAINER=<container-name>
AZURE_STORAGE_CONNECTION_STRING=<connection-string-for-local-dev>
AZURE_STORAGE_USE_MI=false

# Supabase (pgvector)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase-anon-or-service-role-key>

# Ollama (runs locally — no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# Gemini (optional — only required if using aimodel=gemini)
GEMINI_API_KEY=<google-gemini-api-key>
GEMINI_MODEL=gemini-2.0-flash

# RAG tuning (optional — defaults shown)
# RAG_MATCH_COUNT=5
# RAG_MATCH_THRESHOLD=0.3
